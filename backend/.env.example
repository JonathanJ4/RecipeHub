# Comma-separated origins allowed to call the FastAPI backend.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local PostgreSQL container settings. Use different secrets in production.
POSTGRES_DB=recipe_hub
POSTGRES_USER=recipe_hub
POSTGRES_PASSWORD=recipe_hub_dev
DATABASE_URL=postgresql+asyncpg://recipe_hub:recipe_hub_dev@localhost:5432/recipe_hub
